  "сцены": [
    {
      "номер": 1,
      "закадр": "",
      "место": "",
      "персонажи": ["c01"],
      "предметы": ["p01"],
      "речь": {"тип": "нет", "текст": ""},
      "сцена": ""
    }
  ],
  "база_персонажей": [
    {
      "id": "c01",
      "имя": "",
      "внешность": "",
      "одежда": "",
      "характер": "",
      "правила": ""
    }
  ],
  "предметы": [
    {
