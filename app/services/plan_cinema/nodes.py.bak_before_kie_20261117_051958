    return (
        "\n\n### ИСПРАВЬ ПРЕДЫДУЩИЙ ОТВЕТ\n"
        + "\n".join(f"- {item}" for item in problems)
        + "\nВерни ответ заново целиком, только JSON, без пояснений."
