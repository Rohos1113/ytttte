@dataclass(frozen=True)
class PlanCinemaNodeSpec:
    """Описание одной ноды группы (совпадает с ``node_groups/plan_cinema.json``)."""
    kind: str
    local_key: str
    label: str
    prompt_variant: str | None
    output_mode: str

